# Local Compose: secrets are generated into a private Docker volume on first start.
WEB_BIND=127.0.0.1
WEB_PORT=8080
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api,web
# Keep 0 for local HTTP only. Deployment requires HTTPS and 1.
COOKIE_SECURE=0
# Vite development proxy (when the Compose web service is running):
API_PROXY_TARGET=http://localhost:8080
# Demo accounts are never seeded automatically:
# docker compose exec -e DEMO_MODE=1 api python apps/api/manage.py seed_demo
# TRUSTED_PROXY_HOSTS=web is set inside Compose; only that peer may supply X-Real-IP.
