{
  "name": "otklik",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/web",
    "packages/contracts"
  ],
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "dev": "npm run dev -w @otklik/web",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && npm run build -w @otklik/web",
    "check": "npm run lint && npm run build && npm run format:check",
    "format": "prettier --write apps/web/src packages/contracts/src *.mjs",
    "format:check": "prettier --check apps/web/src packages/contracts/src *.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.10.0",
    "globals": "16.5.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.2.2"
  }
}
